# Gemini Multi-Agent Pipeline (Server-only)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Hybrid Storage (Public Client & Server Repo)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key

# Base Sepolia Web3 & Smart Contract Configuration (Chain ID: 84532)
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_SYLLABA_VAULT_ADDRESS=0xe55a108Ba1E3EE56d64d55F96C7144302400f808
NEXT_PUBLIC_SYLLABA_CERTIFICATE_ADDRESS=0xe55a108Ba1E3EE56d64d55F96C7144302400f808
NEXT_PUBLIC_SYLLABA_COIN_ADDRESS=0x95f917B6DA441EC62de4bCA5ea83512a8b60BFA7
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_optional

# Optional IPFS Snapshot Pinning (Falls back to deterministic content-addressed CID if omitted)
PINATA_JWT=your_optional_pinata_jwt

# Optional CLI Contract Deployment Only (NEVER prefix with NEXT_PUBLIC_ and NEVER commit real keys)
DEPLOYER_PRIVATE_KEY=
