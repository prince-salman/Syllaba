{
  "expo": {
    "name": "Syllaba",
    "slug": "syllaba-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "syllaba",
    "userInterfaceStyle": "light",
    "icon": "./assets/syllaba-mark.png",
    "splash": {
      "image": "./assets/syllaba-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "xyz.syllaba.mobile"
    },
    "android": {
      "package": "xyz.syllaba.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/syllaba-mark.png",
        "backgroundColor": "#FACC15"
      }
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
